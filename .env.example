# Obsidian RAG Docker Configuration
# Copy this file to .env and update with your values

# =============================================================================
# CouchDB Configuration
# =============================================================================
COUCHDB_USER=admin
COUCHDB_PASSWORD=your-secure-password-here

# =============================================================================
# Obsidian RAG Configuration
# =============================================================================

# Data source: "vault" (local files) or "couchdb" (Self-hosted LiveSync)
OBSIDIAN_RAG_SOURCE=couchdb

# CouchDB database name (default: obsidian)
OBSIDIAN_RAG_COUCH_DB=obsidian

# =============================================================================
# Embedding Provider Configuration
# =============================================================================

# Provider: "openai", "ollama", or "lmstudio"
OBSIDIAN_RAG_PROVIDER=ollama

# --- OpenAI Settings (if using OpenAI) ---
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OBSIDIAN_RAG_MODEL=text-embedding-3-small

# --- Ollama Settings (if using Ollama) ---
# Model to use for embeddings
OBSIDIAN_RAG_OLLAMA_MODEL=nomic-embed-text

# --- LM Studio Settings (if using LM Studio) ---
# Uncomment if using LM Studio instead of Ollama
# OBSIDIAN_RAG_PROVIDER=lmstudio
# OBSIDIAN_RAG_LMSTUDIO_URL=http://lmstudio:1234
# OBSIDIAN_RAG_LMSTUDIO_MODEL=text-embedding-nomic-embed-text-v1.5

# =============================================================================
# Advanced Configuration
# =============================================================================

# Indexer preset: "default", "math", or "prose"
# OBSIDIAN_RAG_INDEXER_PRESET=default

# Chunk size (tokens)
# OBSIDIAN_RAG_CHUNK_SIZE=1500

# Similarity threshold (0.0-1.0)
# OBSIDIAN_RAG_SIMILARITY_THRESHOLD=0.10